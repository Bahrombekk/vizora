*.pyc
.venv/
venv/
.pytest_cache/

# Env
.env

# Node / frontend
node_modules/
panel/dist/

# Loglar
*.log

# Ildizdagi shaxsiy integratsiya nusxasi — ichida HAQIQIY API kalit bo'ladi.
# Tarqatiladigan versiya docs/ da, kalitsiz.
/vizora-integratsiya.md

# Kamera eksport fayllari — ichida OCHIQ parollar va verify kodlar bo'ladi.
